END:VEVENT

BEGIN:VEVENT
UID:on-victoriaday@aditya-ontario-holidays
DTSTART;VALUE=DATE:19970519
DTEND;VALUE=DATE:19970520
RRULE:FREQ=YEARLY;BYMONTH=5;BYDAY=MO;BYMONTHDAY=18,19,20,21,22,23,24
SUMMARY:👑 Victoria Day
DESCRIPTION:Ontario statutory holiday (Monday on or before May 24)
END:VEVENT

