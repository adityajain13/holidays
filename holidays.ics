BEGIN:VEVENT
UID:on-dststart-old@aditya-ontario-holidays
DTSTART;VALUE=DATE:19970406
DTEND;VALUE=DATE:19970407
RRULE:FREQ=YEARLY;BYMONTH=4;BYDAY=1SU;UNTIL=20061231
SUMMARY:⏩ Daylight Saving Time Starts
DESCRIPTION:Clocks spring forward 1 hour at 2am (pre-2007 rule: 1st Sunday of April)
END:VEVENT

BEGIN:VEVENT
UID:on-dststart-new@aditya-ontario-holidays
DTSTART;VALUE=DATE:20070311
DTEND;VALUE=DATE:20070312
RRULE:FREQ=YEARLY;BYMONTH=3;BYDAY=2SU
SUMMARY:⏩ Daylight Saving Time Starts
DESCRIPTION:Clocks spring forward 1 hour at 2am (2nd Sunday of March, rule since 2007)
END:VEVENT

BEGIN:VEVENT
UID:on-dsend-old@aditya-ontario-holidays
DTSTART;VALUE=DATE:19971026
DTEND;VALUE=DATE:19971027
RRULE:FREQ=YEARLY;BYMONTH=10;BYDAY=-1SU;UNTIL=20061231
SUMMARY:⏪ Daylight Saving Time Ends
DESCRIPTION:Clocks fall back 1 hour at 2am (pre-2007 rule: last Sunday of October)
END:VEVENT

BEGIN:VEVENT
UID:on-dsend-new@aditya-ontario-holidays
DTSTART;VALUE=DATE:20071104
DTEND;VALUE=DATE:20071105
RRULE:FREQ=YEARLY;BYMONTH=11;BYDAY=1SU
SUMMARY:⏪ Daylight Saving Time Ends
DESCRIPTION:Clocks fall back 1 hour at 2am (1st Sunday of November, rule since 2007)
END:VEVENT

